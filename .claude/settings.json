{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build:*)",
      "Bash(pnpm --filter @sharghigold/storefront test:*)",
      "Bash(pnpm --filter @sharghigold/storefront build:*)",
      "Bash(pnpm --filter @sharghigold/storefront typecheck:*)",
      "Bash(pnpm --filter @sharghigold/storefront exec vitest:*)",
      "Bash(pnpm --filter @sharghigold/api test:*)",
      "Bash(pnpm --filter @sharghigold/api build:*)",
      "Bash(pnpm --filter @sharghigold/api typecheck:*)",
      "Bash(pnpm --filter @sharghigold/api exec vitest:*)",
      "Bash(pnpm --filter @sharghigold/contracts test:*)",
      "Bash(pnpm --filter @sharghigold/contracts build:*)",
      "Bash(pnpm --filter @sharghigold/contracts typecheck:*)",
      "Bash(pnpm --filter @sharghigold/contracts exec vitest:*)",
      "Bash(pnpm --filter @sharghigold/money test:*)",
      "Bash(pnpm --filter @sharghigold/money build:*)",
      "Bash(pnpm --filter @sharghigold/money typecheck:*)",
      "Bash(pnpm --filter @sharghigold/money exec vitest:*)",
      "Bash(pnpm --filter @sharghigold/ui test:*)",
      "Bash(pnpm --filter @sharghigold/ui build:*)",
      "Bash(pnpm --filter @sharghigold/ui typecheck:*)",
      "Bash(pnpm --filter @sharghigold/ui exec vitest:*)",
      "Bash(pnpm --filter @sharghigold/database test:*)",
      "Bash(pnpm --filter @sharghigold/database build:*)",
      "Bash(pnpm --filter @sharghigold/database typecheck:*)",
      "Bash(pnpm --filter @sharghigold/database exec vitest:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec oxlint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(graphify query:*)",
      "Bash(graphify path:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify update:*)"
    ],
    "deny": [
      "Read(./packages/ui/design-system/_ds_bundle.js)",
      "Read(./pnpm-lock.yaml)",
      "Read(**/*.woff2)",
      "Read(**/.next/**)",
      "Read(./packages/database/src/generated/**)",
      "Read(./graphify-out/graph.json)",
      "Read(./graphify-out/graph.html)",
      "Read(./graphify-out/cache/**)"
    ]
  }
}
