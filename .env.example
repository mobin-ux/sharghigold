# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/sharghigold_dev

# --- Redis / session + rate-limit store -----------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- API ------------------------------------------------------------------
API_PORT=3001
# Interface to bind. Loopback by default so the API is not published; a
# container must set 0.0.0.0, because its loopback is not reachable outside it.
API_BIND_HOST=127.0.0.1
# Comma-separated exact origins. Never "*" for authenticated requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Session --------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=
SESSION_TTL_SECONDS=2592000

# --- Storefront -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001

# --- Gold pricing ---------------------------------------------------------
# How long a checkout price quote stays honoured before re-confirmation.
PRICE_QUOTE_TTL_SECONDS=900
# Refuse to transact on a spot price older than this.
GOLD_PRICE_MAX_STALENESS_SECONDS=600

# --- SMS / OTP (Iranian provider) -----------------------------------------
# "log" writes messages to the server log and sends nothing. Fine for local
# work; the API refuses to boot with it in production, because it would mean
# every login code is written to a file and none of them is delivered.
SMS_PROVIDER=log
SMS_BASE_URL=https://api.sms-webservice.com/api/V3
SMS_API_KEY=
# The sending line, digits only. `AccountInfo` reports the lines the panel
# actually holds — read it rather than guessing.
SMS_SENDER=
# The approved template a login code is sent through. Required in production:
# a code sent as free text goes out over the ordinary line and is silently
# dropped for anyone who has ever blocked advertising from it.
SMS_OTP_TEMPLATE_KEY=
SMS_TIMEOUT_MS=8000
OTP_TTL_SECONDS=120

# --- Payment gateway (Iranian PSP) ----------------------------------------
PSP_PROVIDER=
PSP_MERCHANT_ID=
PSP_CALLBACK_URL=http://localhost:3000/payment/callback

# Next.js sends anonymous usage telemetry by default. Disabled: this is a
# production project hosted inside Iran, where the outbound call is both a
# privacy question and unreliable.
NEXT_TELEMETRY_DISABLED=1
