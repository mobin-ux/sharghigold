{
  "name": "sharghigold",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sharghigold/storefront dev",
    "build": "pnpm build:packages && pnpm build:apps",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "build:apps": "pnpm -r --parallel --filter \"./apps/**\" build",
    "typecheck": "pnpm -r --parallel --no-bail typecheck",
    "test": "pnpm -r --parallel --no-bail test",
    "lint": "oxlint --config .oxlintrc.json",
    "lint:fix": "oxlint --config .oxlintrc.json --fix",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "verify": "pnpm format:check && pnpm lint && pnpm build:packages && pnpm typecheck && pnpm test && pnpm build:apps"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
